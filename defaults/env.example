# Settings for finbot, one KEY=value per line.
# Used by systemd (EnvironmentFile=) and docker (--env-file), or sourced by a shell for a manual run.
# No spaces around "=", no quotes, no trailing comments; put comments on their own line.

sharesight_code=
sharesight_client_id=
sharesight_client_secret=
# set False if Yahoo breaks
trades_use_yahoo=True

slack_webhook=
discord_webhook=
telegramBotToken=
telegramChatID=

past_days=0
future_days=7
price_percent=9.4
shorts_percent=15

cache=True
# run the scheduled reports (schedule.cron) inside bot.py; on by default. Set False to keep using cron, and remove old crontab entries when it is on
# scheduler=False
# where state and cache live (default: var/ in the checkout; cache is DATA_DIR/cache)
# DATA_DIR=/data

exclude_portfolios=
include_portfolios=

# interactive mode
slackToken=
# telegramOutgoingWebhook=
# slackOutgoingWebhook=
ip=127.0.0.1
port=5000
