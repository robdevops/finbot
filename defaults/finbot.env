# finbot.env: THE STARTUP FILE. Where finbot runs, who it talks to, where it reports, and whether it schedules.
# The bot never reads this file. Your launcher loads it into the bot's environment, and a change needs a RESTART:
#   systemd:  EnvironmentFile=/opt/finbot.env             (in finbot.service)
#   docker:   --env-file /opt/finbot.env
#   init.d:   set -a; . /opt/finbot.env; set +a; ./bot.py
# Keep it private: chmod 600, owned by root. It holds the credentials.
# Flat KEY=value lines: no spaces around "=", no quotes (docker keeps quotes literally), no trailing comments; comments
# on their own line.
# Everything else (thresholds, windows, display, caching, ...) is in preferences.conf, which the bot reloads without a
# restart.
# A preference key in this file is an error: finbot refuses to start. Lint both files with:
#   util/check_config.py /opt/finbot.env

# Where state and cache live. Leave unset under systemd with StateDirectory=finbot (it uses $STATE_DIRECTORY,
# /var/lib/finbot).
# DATA_DIR=/var/lib/finbot

# The listening socket, for a network in http mode (its webhook URL set below)
ip=127.0.0.1
port=5000

# Run the scheduled reports (schedule.cron) inside the bot, and how many minutes late a run missed while the bot was
# down may still fire
scheduler=True
scheduler_catchup=5

# Where scheduled reports go on Telegram: the chat group or channel id
telegramChatID=

# Sharesight API access
sharesight_code=
sharesight_client_id=
sharesight_client_secret=

# Chat networks. A Telegram bot token is enough for reports and commands: finbot fetches its updates (pull mode)
slack_webhook=
discord_webhook=
telegramBotToken=
slackBotToken=
# Slack channel id for scheduled reports as the bot, charts and all (needs slackBotToken; slack_webhook is then unused)
slackChannelID=

# Chat networks: inbound over HTTPS (http mode). Telegram: set both to have it post its updates to your server
# instead of finbot fetching them
telegramOutgoingWebhook=
telegramOutgoingToken=
slackOutgoingWebhook=
slackOutgoingToken=
slackSigningSecret=
