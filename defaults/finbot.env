# finbot.env: THE STARTUP ENV. Where finbot runs, and who it talks to.
# The bot never reads this file. Your launcher loads it into the bot's environment, and a change needs a RESTART:
#   systemd:  EnvironmentFile=/etc/finbot.env             (in finbot.service)
#   docker:   --env-file /etc/finbot.env
#   init.d:   set -a; . /etc/finbot.env; set +a; ./bot.py
# Keep it private: chmod 600, owned by root:root. It holds the credentials (check_config.py warns if not).
# Flat KEY=value lines: no spaces around "=", no quotes (docker keeps quotes literally), no trailing comments; comments
# on their own line.
# Everything else (thresholds, windows, display, caching, ...) is in settings.conf, which the bot reloads without a
# restart.
# A setting key in this file is an error: finbot refuses to start. Lint both files with:
#   util/check_config.py /etc/finbot.env

# Where state and cache live. Leave unset under systemd with StateDirectory=finbot (it uses $STATE_DIRECTORY,
# /var/lib/finbot, the only directory the shipped unit can write).
# DATA_DIR=/var/lib/finbot

# The listening socket, for a network in push mode (its webhook URL set below)
IP=127.0.0.1
PORT=5000

# The charts' theme. off: light; on: dark; auto: dark from 18:00 to 06:00 in the timezone setting (settings.conf)
DARKMODE=off

# How many minutes late a scheduled report missed while the bot was down may still fire
SCHEDULER_CATCHUP=5

# Sharesight API access
SHARESIGHT_CLIENT_ID=
SHARESIGHT_CLIENT_SECRET=

# Chat networks. A Telegram bot token is enough for reports and commands: by default, finbot fetches its updates
# (pull mode)
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
# Slack's app-level token (xapp-), for Socket Mode, the default: finbot opens a socket to Slack for its updates
SLACK_APP_TOKEN=
# Discord's bot token: reports, and commands over the gateway API (pull mode, the default)
DISCORD_BOT_TOKEN=

# Chat networks: inbound over HTTPS (push mode). Telegram: set both to have it post its updates to your server
# instead of finbot fetching them
TELEGRAM_OUTGOING_WEBHOOK=
TELEGRAM_SECRET_TOKEN=
# Discord: the Interactions Endpoint URL and the app's public key, for slash commands and buttons over HTTPS instead of
# the gateway API
DISCORD_OUTGOING_WEBHOOK=
DISCORD_PUBLIC_KEY=
SLACK_OUTGOING_WEBHOOK=
SLACK_OUTGOING_TOKEN=
SLACK_SIGNING_SECRET=
