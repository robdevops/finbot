[Unit]
Description=Finbot interactive chat bot

[Service]
Type=simple
# No user to make: systemd runs finbot as a throwaway user, and gives it /var/lib/finbot for its state
# (StateDirectory=). The checkout is in /opt/finbot, which that user can read. Optional: finbot.service.d/hardening.conf
DynamicUser=yes
StateDirectory=finbot
ExecStart=/opt/finbot/bot.py
# systemctl reload finbot re-reads settings.conf without a restart
ExecReload=/bin/kill -HUP $MAINPID
# Refuse to start on a typo in finbot.env or settings.conf ("+" runs the check as root)
ExecStartPre=+/opt/finbot/util/check_config.py /opt/finbot.env
Restart=on-failure
RestartSec=30s
StandardOutput=null
StandardError=journal
SyslogIdentifier=finbot
Environment=PYTHONUNBUFFERED=1
# finbot.env: loaded by systemd as root (600 root:root); a change needs a restart
EnvironmentFile=/opt/finbot.env

[Install]
WantedBy=multi-user.target
