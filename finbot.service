[Unit]
Description=Finbot interactive chat bot

[Service]
Type=simple
User=CHANGEME
# Or, instead of User=: DynamicUser=yes plus StateDirectory=finbot (state goes to /var/lib/finbot automatically)
ExecStart=/home/CHANGEME/finbot/bot.py
Restart=on-failure
RestartSec=30s
StandardOutput=null
StandardError=journal
SyslogIdentifier=finbot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/CHANGEME/finbot/.env

[Install]
WantedBy=multi-user.target
