[Unit]
Description=Finbot interactive chat bot

[Service]
Type=simple
User=CHANGEME
# Or instead of User=: DynamicUser=yes and StateDirectory=finbot (state in /var/lib/finbot)
ExecStart=/home/CHANGEME/finbot/bot.py
# systemctl reload finbot re-reads preferences.conf without a restart
ExecReload=/bin/kill -HUP $MAINPID
# Refuse to start on a typo in finbot.env or preferences.conf ("+" runs the check as root)
ExecStartPre=+/home/CHANGEME/finbot/util/check_config.py /opt/finbot.env
Restart=on-failure
RestartSec=30s
StandardOutput=null
StandardError=journal
SyslogIdentifier=finbot
Environment=PYTHONUNBUFFERED=1
# finbot.env: loaded by systemd as root (chmod 600); a change needs a restart
EnvironmentFile=/opt/finbot.env

[Install]
WantedBy=multi-user.target
